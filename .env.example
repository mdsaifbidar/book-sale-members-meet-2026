# Copy this file to .env.local and fill in real values.
# .env.local is already gitignored — never commit real secrets.

# --- Supabase ---
# Project Settings -> API in your Supabase dashboard.
# The publishable key is safe to expose in the browser (it's the modern
# replacement for the old "anon key" name) — all data access is still
# gated by Row Level Security (see supabase/migrations/0001_schema.sql).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# --- Admin login (single shared account) ---
# This app uses a single Supabase Auth user as the shared admin login.
# Create it once in Supabase Dashboard -> Authentication -> Users -> Add user,
# using the email/password below (or your own). These two lines are purely
# documentation for whoever sets up the project — nothing reads them at
# runtime. Change the password (Account page, once logged in) before the event.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-before-production

# --- Email receipts (optional, not built in v1) ---
# Present for forward-compatibility; leave unset to keep the feature dormant.
# RESEND_API_KEY=
